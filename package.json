    "@types/react-dom": "19.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  },
